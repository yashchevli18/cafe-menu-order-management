PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string. Copy it from Atlas > Database > Connect > Drivers and
# make sure the database name (brew_and_bean) is included before the "?".
# URL-encode special characters in the password (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/brew_and_bean?retryWrites=true&w=majority&appName=<app-name>

# Allowed browser origins (comma-separated), e.g. http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Shared secret for management endpoints (menu create/update/delete, order list/details/status).
# Send it in the x-api-key header (Swagger: "Authorize" button). Required when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANAGEMENT_API_KEY=<paste-a-long-random-secret-here>

# Number of reverse proxies in front of the app (Render uses 1). Needed for correct rate limiting.
TRUST_PROXY=0
