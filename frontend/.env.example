# Local development: keep "/api". Vite proxies it to the backend (see DEV_API_PROXY_TARGET),
# so phones on the same Wi-Fi can use the app through http://<your-PC-IP>:5173.
# Production (Vercel): set the full Render URL, e.g. https://your-service.onrender.com/api
VITE_API_BASE_URL=/api

# Where the dev/preview proxy forwards /api requests (development only).
DEV_API_PROXY_TARGET=http://localhost:5000
